# =============================================================================
# E2E H200 vLLM Deployment Kit - Central Configuration
# =============================================================================
# Edit this file to customize your deployment. All scripts source this file.

# -- Model Configuration ------------------------------------------------------
MODEL_ID="meta-llama/Llama-3.1-8B-Instruct"
# Other options:
#   meta-llama/Llama-3.1-70B-Instruct   (fits in 141GB HBM3e with FP8)
#   mistralai/Mistral-7B-Instruct-v0.3
#   Qwen/Qwen2.5-72B-Instruct
#   google/gemma-2-27b-it

# HuggingFace token (required for gated models like Llama)
HF_TOKEN="${HF_TOKEN:-}"

# -- Storage Paths (E2E H200 layout) -----------------------------------------
# Persistent across reboots - use for models & adapters
PERSISTENT_DIR="/home/jovyan"
MODEL_CACHE_DIR="${PERSISTENT_DIR}/models"
ADAPTER_DIR="${PERSISTENT_DIR}/adapters"
TRAINING_OUTPUT_DIR="${PERSISTENT_DIR}/training_outputs"

# Fast NVMe ephemeral storage - lost on shutdown, use for scratch/logs
EPHEMERAL_DIR="/mnt/local"
VLLM_LOGS_DIR="${EPHEMERAL_DIR}/vllm_logs"

# -- vLLM Serving Configuration -----------------------------------------------
SERVE_PORT=8000
SERVE_HOST="0.0.0.0"

# Tensor parallelism (number of GPUs). H200 single GPU = 1
TENSOR_PARALLEL_SIZE=1

# Maximum model context length (adjust based on model & available memory)
MAX_MODEL_LEN=8192

# GPU memory utilization (0.0-1.0). H200 has 141GB, leave headroom for KV cache
GPU_MEMORY_UTILIZATION=0.90

# Quantization: null, fp8, awq, gptq
QUANTIZATION=""

# Dtype: auto, float16, bfloat16
DTYPE="auto"

# Maximum number of LoRA adapters that can be loaded simultaneously
MAX_LORAS=4

# Enable chunked prefill for better TTFT with long prompts
ENABLE_CHUNKED_PREFILL=true

# -- Fine-tuning Configuration ------------------------------------------------
FINETUNE_METHOD="lora"          # lora or qlora
LORA_R=16                       # LoRA rank
LORA_ALPHA=32                   # LoRA alpha
LORA_DROPOUT=0.05
LEARNING_RATE=2e-4
NUM_EPOCHS=3
BATCH_SIZE=4
GRADIENT_ACCUMULATION_STEPS=4
MAX_SEQ_LENGTH=2048
WARMUP_RATIO=0.03
LOGGING_STEPS=10
SAVE_STEPS=100

# -- Docker / E2E Container Registry ------------------------------------------
E2E_REGISTRY="registry.e2enetworks.net"
IMAGE_NAME="vllm-h200"
IMAGE_TAG="latest"
